# HakiChain AI backend (Word add-in MVP)
# Copy to .env and fill in. Never commit secrets.

# --- Supabase (same project the add-in uses) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# JWT secret from Project Settings -> API. Used to verify HS256 access tokens.
# Newer projects may use ECC (JWKS) instead; leave this blank and JWKS will be used.
SUPABASE_JWT_SECRET=
# Service role key. Backend only. NEVER put this in the add-in bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM (OpenAI-compatible: OpenAI, Groq, Azure, local) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Server ---
# Comma-separated exact origins (credentials CORS).
CORS_ORIGINS=https://localhost:3000,https://word.hakichain.ai
HOST=0.0.0.0
PORT=8000
